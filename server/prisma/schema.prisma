generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Genre {
  COMEDY
  ROMANCE
  FANTASY
  ADVENTURE
  ACTION
  MAGIC
  SCHOOL_LIFE
  PARANORMAL
}

model User {
  id                String                                 @id @default(uuid()) @db.Uuid
  email             String                                 @unique
  hash              String      @map("password_hash")
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  twitterUsername   String?     @map("twitter_username")
  telegramUsername  String?     @map("telegram_username")
  instagramUsername String?     @map("instagram_username")
  createdAt         DateTime    @map("created_at")         @default(now())
  updatedAt         DateTime    @map("updated_at")         @default(now())
  session           Session[]
  avatar            Avatar[]
  likes             MovieLike[]
  wishes            WishList[]

  @@map("users")
}

model Session {
  id           String                         @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")       @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @map("refresh_token") @unique
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceType   String?  @map("device_type")
  os           String?
  browser      String?
  expiresAt    DateTime @map("expires_at")
  
  createdAt    DateTime @map("created_at")    @default(now())
  updatedAt    DateTime @map("updated_at")    @default(now())

  @@map("sessions")
}

model Avatar {
  id        String                      @id @default(uuid()) @db.Uuid
  url       String
  userId    String   @map("user_id")    @db.Uuid

  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @default(now())

  @@map("avatars")
}

model WishList {
  id        String                      @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id" )   @db.Uuid
  movieId   String   @map("movie_id")   @db.Uuid

  user      User     @relation(fields: [userId], references: [id])
  movie     Movie    @relation(fields: [movieId], references: [id])

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @default(now())

  @@map("wish_list")
  @@unique([userId, movieId])
}

model Movie {
  id          String                            @id @default(uuid()) @db.Uuid()
  posterUrl   String       @map("poster_url")
  title       String
  description String
  rating      Int                               @default(0)
  releaseYear Int          @map("release_year")
  trailerUrl  String       @map("trailer_url")
  createdAt   DateTime     @map("created_at")   @default(now())
  updatedAt   DateTime     @map("updated_at")   @default(now())
  genres      Genre[]
  screenshots Screenshot[]
  likes       MovieLike[]
  wishes      WishList[]

  @@map("movies")
}

model MovieLike {
  id        String                      @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")    @db.Uuid
  movieId   String   @map("movie_id")   @db.Uuid

  user      User     @relation(fields: [userId], references: [id])
  movie     Movie    @relation(fields: [movieId], references: [id])

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @default(now())

  @@unique([movieId, userId])
  @@map("movies_likes")
}

model Screenshot {
  id        String                      @id @default(uuid()) @db.Uuid
  url       String
  movieId   String   @map("movie_id")   @db.Uuid()

  movie     Movie    @relation(fields: [movieId], references: [id])

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @default(now())

  @@map("screenshots")
}
